<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Approximate location is requested at runtime only for Auto weather. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Needed to query for system media-template V2 handlers (Android 11+). -->
    <queries>
        <intent>
            <action android:name="androidx.car.app.mediaextensions.action.MEDIA_TEMPLATE_V2" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:label="Auto Clock 2"
        android:icon="@drawable/ic_auto_clock"
        android:supportsRtl="true"
        android:theme="@style/Theme.AutoClock">

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Host-activated TEST 1 session activity; never background-launched. -->
        <activity
            android:name=".media.AutoClockBrowseTrampolineActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".media.AutoClockMediaService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <provider
            android:name=".artwork.ClockArtworkProvider"
            android:authorities="com.kotarov.autoclock2.artwork"
            android:exported="true"
            android:grantUriPermissions="true" />

    </application>
</manifest>
