<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Weather is requested only for active weather modes. No location permission. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="Auto Clock"
        android:icon="@drawable/ic_auto_clock"
        android:supportsRtl="true"
        android:theme="@style/Theme.AutoClock">

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".media.AutoClockMediaService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <provider
            android:name=".artwork.ClockArtworkProvider"
            android:authorities="com.kotarov.autoclock.artwork"
            android:exported="true"
            android:grantUriPermissions="true" />

    </application>
</manifest>
